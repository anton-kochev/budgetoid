<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DbProvision</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- Infrastructure resolves EF Core Relational 10.0.9 through its EntityFrameworkCore.Design
             reference, which is PrivateAssets=all and so does not flow here — leaving this project on
             the 10.0.4 that Npgsql.EntityFrameworkCore.PostgreSQL asks for, and the build on MSB3277.
             Pin it to match, as Api.csproj already does for the same reason. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj"/>
    </ItemGroup>
</Project>
