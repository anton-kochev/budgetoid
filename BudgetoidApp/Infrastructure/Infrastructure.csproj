<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2"/>
        <!-- Turns the forbidden-API list in BannedSymbols.txt (IgnoreQueryFilters, FromSql*,
             Find, ExecuteUpdate/Delete, ...) into RS0030 compile errors. See TECH_DEBT.md,
             "Data isolation invariant". -->
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="..\BannedSymbols.txt"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Application\Application.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Persistence\Provisioning\app-role-grants.sql"/>
    </ItemGroup>
    <!--
      Granted to the integration suite alone, for the provisioning members that take an AppRole.

      Production has exactly one application role, budgetoid_app, and every public provisioning
      member still provisions that one. The suite needs others: a deployment test sabotages the role
      it provisions — alters it, renames it, grants it a parameter — and on one shared PostgreSQL
      server a role is server-wide, so two tests sabotaging budgetoid_app at once would read each
      other's damage. Each test therefore provisions a role of its own, through internal overloads
      that take the role as an AppRole.

      Internal rather than public because a public parameter is one the application could pass too,
      and the deploy step would then have a way to provision some other role than the one the API
      connects as. AppRole is internal as well, so no public member can take one. What travels is
      visibility to a test assembly, not a dependency: nothing in the application references it.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="IntegrationTests"/>
    </ItemGroup>
</Project>
