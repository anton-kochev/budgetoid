<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTestProject>true</IsTestProject>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.1.0"/>
        <!-- Pinned to the version Infrastructure builds against. Referencing Infrastructure brings
             EF Core in transitively, and the PostgreSQL provider's floor (10.0.4) otherwise wins
             over Microsoft.EntityFrameworkCore 10.0.9 here, which is a load-time version mismatch
             rather than a tidiness warning. Every other project reaches 10.0.9 already. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9"/>
        <PackageReference Include="TUnit" Version="1.56.0"/>
    </ItemGroup>
    <ItemGroup>
        <!-- CurrentUserWriter and the two context readers beside it are request-scoped state with no
             ASP.NET Core surface of their own, so they are unit-testable — but they live in Api,
             because IUserContextWriter is deliberately declared next to its single consumer rather
             than in a layer everything can reach. Referencing Api here is what lets the rule about
             what publishing an identity does to the ambient budget be pinned as a unit test instead
             of standing up a container to observe a two-field assignment. -->
        <ProjectReference Include="..\..\Api\Api.csproj"/>
        <ProjectReference Include="..\..\Application\Application.csproj"/>
        <ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj"/>
        <ProjectReference Include="..\TestSupport\TestSupport.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Api targets the Web SDK, so its assembly resolves against the ASP.NET Core shared
             framework at run time. Nothing under test here touches it, but loading the assembly at
             all needs it present, and this project is a plain console app. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>
</Project>
