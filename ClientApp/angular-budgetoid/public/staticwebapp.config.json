{
  "routes": [
    {
      "route": "/fonts/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "*.{json,css,js,ico,png,svg,webmanifest,woff,woff2}"
    ]
  }
}
